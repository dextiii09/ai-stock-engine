# AI Stock Analyst Environment Variables

# NVIDIA NIM API Key (for Nemotron AI synthesis — primary LLM provider)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Note: The system currently runs entirely on Yahoo Finance (yfinance) for market data. No API keys are required for data ingestion!

# Telegram Alerts (optional — enable in config.yaml)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Alerts (optional — enable in config.yaml)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Other Overrides
# APP_ENVIRONMENT=production
# LOGGING_LEVEL=DEBUG
